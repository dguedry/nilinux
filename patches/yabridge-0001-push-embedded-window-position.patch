+                                parent_window_config_.height = geometry->height;
+                                logger_.log_editor_trace([&]() {
+                                    return "DEBUG: Parent size from X: " +
+                                           std::to_string(geometry->width) +
+                                           "x" +
+                                           std::to_string(geometry->height);
+                                });
+                            }
+                        }
+
