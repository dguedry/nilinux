                         translated_event.response_type = XCB_CONFIGURE_NOTIFY;
                         translated_event.event = wine_window_;
@@ -693,6 +758,7 @@ void Editor::handle_x11_events() noexcept {
                         wine_window_, xcb_wm_state_property_,
